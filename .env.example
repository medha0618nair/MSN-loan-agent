# Environment variables for multi-agent loan system

# Groq API Key (PRIMARY - use placeholder, do NOT commit real keys)
GROQ_API_KEY=your-groq-api-key-here

# OpenAI API Key (optional alternative)
# OPENAI_API_KEY=your-openai-api-key-here

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Service ports
INTAKE_AGENT_PORT=8001
KYC_AGENT_PORT=8002

# Storage paths
DOCS_PATH=./data/docs
UPLOAD_PATH=./data/uploads
CROPS_PATH=./data/crops

# Logging
LOG_LEVEL=INFO
