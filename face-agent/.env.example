# Environment Configuration Template
# Copy to .env and customize for your environment

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
HOST=0.0.0.0
PORT=8000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_PATH=./embeddings.db

# Data retention policy (days)
DATA_RETENTION_DAYS=90

# ============================================================================
# FACE DETECTION CONFIGURATION
# ============================================================================
# Face detection confidence threshold (0.0-1.0)
FACE_DETECTION_CONFIDENCE=0.5

# MediaPipe model selection (0=short-range, 1=full-range)
FACE_DETECTION_MODEL=1

# ============================================================================
# LIVENESS DETECTION CONFIGURATION
# ============================================================================
# Eye aspect ratio threshold for blink detection
BLINK_THRESHOLD=0.3

# ============================================================================
# SIMILARITY CONFIGURATION
# ============================================================================
# Cosine similarity threshold for face matching
# Use 0.85+ for strict matching, 0.75-0.85 for moderate
SIMILARITY_THRESHOLD=0.85

# ============================================================================
# MATCH CONFIDENCE WEIGHTS
# ============================================================================
# Weight for similarity score in match confidence (0.0-1.0)
WEIGHT_SIMILARITY=0.7

# Weight for liveness score in match confidence (0.0-1.0)
WEIGHT_LIVENESS=0.3

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (empty = console only)
LOG_FILE=./logs/face_verification.log

# ============================================================================
# PERFORMANCE CONFIGURATION
# ============================================================================
# Number of worker processes
WORKERS=1

# Request timeout in seconds
REQUEST_TIMEOUT=30

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Enable CORS (for browser-based clients)
ENABLE_CORS=false

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# API key for authentication (leave empty to disable)
API_KEY=

# ============================================================================
# IMAGE PROCESSING CONFIGURATION
# ============================================================================
# Minimum image width (pixels)
MIN_IMAGE_WIDTH=300

# Minimum image height (pixels)
MIN_IMAGE_HEIGHT=300

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================
# Enable debug mode (do not use in production)
DEBUG=false

# Reload on code changes
RELOAD=false

# ============================================================================
# ORCHESTRATOR INTEGRATION
# ============================================================================
# Orchestrator service URL for callbacks
ORCHESTRATOR_URL=http://localhost:8001

# Agent version (for tracking)
AGENT_VERSION=face-v1
